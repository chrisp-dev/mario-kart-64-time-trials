generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model TimeTrial {
  id         Int      @id @default(autoincrement())
  date       DateTime
  track_id   Int
  character  String
  lap1       String
  lap2       String
  lap3       String
  final_time String
  notes      String?
}
